# EC2 + Docker Compose — copy to .env on the server (same folder as docker-compose.yml).
# DB values MUST match docker-compose.yml (service "db").

DEBUG=False
SECRET_KEY=PASTE_A_KEY_FROM_python_manage.py_shell_get_random_secret_key
ALLOWED_HOSTS=13.228.42.236,localhost,127.0.0.1,neat-now-admin-panel-web-noor.vercel.app
# Serve /media/ from disk when DEBUG=False (required for local report images on EC2)
SERVE_LOCAL_MEDIA=True

# Flutter release APK + React admin (Vercel proxy) — same API host
# Mobile apps do not use browser CORS; ALLOWED_HOSTS above is what matters for the app.
CORS_ALLOW_ALL_ORIGINS=True

DB_NAME=neat_now_db
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=db
DB_PORT=5432
